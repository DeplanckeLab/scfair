<div class="sm:flex sm:items-start">
  <div class="w-full text-left">
    <h3 class="text-lg font-semibold text-gray-900 pr-8">
      Projects not passing check
    </h3>
    <p class="mt-1 text-sm text-gray-600">
      <%= @title %> — <%= @column_name %>
    </p>
    <p class="mt-1 text-xs text-gray-500 font-mono">
      <%= @field %>
    </p>

    <% if @failing_datasets.empty? %>
      <p class="mt-6 text-sm text-gray-500">No failing or warning projects for this check.</p>
    <% else %>
      <p class="mt-3 text-xs text-gray-500"><%= @failing_datasets.size %> project<%= @failing_datasets.size == 1 ? "" : "s" %></p>
      <ul class="mt-3 max-h-[28rem] overflow-y-auto divide-y divide-gray-100 border border-gray-200 rounded-md">
        <% @failing_datasets.each do |row| %>
          <li class="px-3 py-2.5 flex items-start justify-between gap-3">
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-mono text-sm text-gray-900"><%= row.source_reference_id %></span>
                <% if row.source_version.present? %>
                  <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-gray-100 text-gray-700">
                    <%= row.source_version %>
                  </span>
                <% end %>
                <%
                  status_class =
                    if row.status == "failed"
                      "bg-red-100 text-red-800"
                    else
                      "bg-yellow-100 text-yellow-800"
                    end
                %>
                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold <%= status_class %>">
                  <%= row.status %>
                </span>
              </div>
              <% if row.message.present? %>
                <p class="mt-1 text-xs text-gray-500 break-words"><%= row.message %></p>
              <% end %>
            </div>
            <div class="shrink-0 flex items-center gap-2">
              <% if row.asap_id.present? %>
                <%= link_to "Check",
                      asap_standalone_compliance_check_url(row.asap_id),
                      class: "text-xs font-medium text-brand-dark hover:underline",
                      target: "_blank",
                      rel: "noopener noreferrer" %>
              <% end %>
              <% if row.explorer_url.present? %>
                <%= link_to "Explore",
                      row.explorer_url,
                      class: "text-xs font-medium text-brand-dark hover:underline",
                      target: "_blank",
                      rel: "noopener noreferrer" %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
