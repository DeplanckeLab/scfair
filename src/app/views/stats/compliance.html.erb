<div class="container mx-auto px-4 mt-4 mb-8" data-controller="stats-check-modal">
  <div class="min-h-screen py-8">
    <div class="max-w-7xl mx-auto space-y-8">
      <div class="flex flex-col items-center gap-2">
        <h2 class="text-2xl font-bold text-center">
          <% if @include_all %>
            scFAIR compliance statistics by resource (all)
          <% else %>
            scFAIR compliance statistics by resource
          <% end %>
        </h2>
        <p class="text-sm text-gray-600 text-center">
          <%= link_to "Back to data statistics", stats_path, class: "text-red-500 hover:text-red-600" %>
        </p>
        <% if @include_all %>
          <p class="text-xs text-gray-500 text-center max-w-3xl">
            Includes Bgee, Single Cell Portal, and Bgee v16 (same files as Bgee with
            <span class="font-mono">/ftp/current/</span> replaced by
            <span class="font-mono">/ftp/16/</span> in the download URL).
          </p>
        <% end %>
      </div>

      <div class="bg-white rounded-lg border border-gray-200 overflow-x-auto">
        <h3 class="text-lg font-semibold px-4 pt-4">Coverage</h3>
        <table class="min-w-full text-sm">
          <thead>
            <tr class="border-b border-gray-200">
              <th class="px-4 py-3 text-left font-medium text-gray-600 sticky left-0 bg-white">Metric</th>
              <% @coverage.each do |coverage| %>
                <th class="px-4 py-3 text-center font-medium text-gray-900">
                  <div class="inline-flex items-center justify-center gap-2">
                    <span class="inline-flex items-center justify-center w-7 h-7 rounded <%= coverage.column.name.start_with?('CELLxGENE') ? 'bg-brand-dark' : 'bg-gray-200' %>">
                      <%= image_tag "#{coverage.column.logo || 'not_found.svg'}", class: "w-4 h-4", alt: "#{coverage.column.name} logo" %>
                    </span>
                    <span>
                      <%= coverage.column.name %><% if coverage.column.key == ComplianceCheckStats::ASAP_V8_COLUMN_KEY %><span class="text-gray-500" title="See footnote">*</span><% end %>
                    </span>
                  </div>
                </th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100">
              <td class="px-4 py-2 sticky left-0 bg-white text-gray-700">File resources</td>
              <% @coverage.each do |coverage| %>
                <td class="px-4 py-2 text-center"><%= coverage.file_resources_count %></td>
              <% end %>
            </tr>
            <tr class="border-b border-gray-100 bg-gray-50">
              <td class="px-4 py-2 sticky left-0 bg-gray-50 text-gray-700">Checked</td>
              <% @coverage.each do |coverage| %>
                <td class="px-4 py-2 text-center"><%= coverage.checked_count %></td>
              <% end %>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="px-4 py-2 sticky left-0 bg-white text-gray-700">Passed</td>
              <% @coverage.each do |coverage| %>
                <td class="px-4 py-2 text-center text-green-800"><%= coverage.passed_count %></td>
              <% end %>
            </tr>
            <tr class="border-b border-gray-100 bg-gray-50">
              <td class="px-4 py-2 sticky left-0 bg-gray-50 text-gray-700">Failed validation</td>
              <% @coverage.each do |coverage| %>
                <td class="px-4 py-2 text-center text-red-800"><%= coverage.failed_count %></td>
              <% end %>
            </tr>
            <tr>
              <td class="px-4 py-2 sticky left-0 bg-white text-gray-700">Check run failed</td>
              <% @coverage.each do |coverage| %>
                <td class="px-4 py-2 text-center text-gray-600"><%= coverage.failed_run_count %></td>
              <% end %>
            </tr>
            <tr class="border-t border-gray-200 bg-gray-50">
              <td class="px-4 py-2 sticky left-0 bg-gray-50 text-gray-700">Individual checks passing</td>
              <% @coverage.each do |coverage| %>
                <td class="px-4 py-2 text-center font-medium">
                  <% if coverage.individual_checks_pass_rate %>
                    <%= coverage.individual_checks_pass_rate %>%
                  <% else %>
                    <span class="text-gray-400">-</span>
                  <% end %>
                </td>
              <% end %>
            </tr>
          </tbody>
        </table>
        <p class="px-4 py-3 text-xs text-gray-500">
          * At the moment, all currently scFAIR-valid projects are imported from CELLxGENE and automatically updated to comply with the scFAIR schema.
        </p>
      </div>

      <div class="bg-white rounded-lg border border-gray-200 overflow-x-auto">
        <h3 class="text-lg font-semibold px-4 pt-4">Checks by resource</h3>
        <p class="px-4 pb-2 text-xs text-gray-500">
          Pass rate among passed and failed outcomes (warnings excluded and marked with *). Not applicable checks are shown as - and excluded from the rate.
          Equivalent H5AD and Loom checks are shown on the same row.
          Click a percentage below 100% to list projects that failed or warned on that check. A clickable - lists projects with warnings only.
        </p>
        <table class="min-w-full text-sm">
          <thead>
            <tr class="border-b border-gray-200">
              <th class="px-4 py-3 text-left font-medium text-gray-600 sticky left-0 bg-white min-w-[16rem]">Check</th>
              <% @columns.each do |column| %>
                <th class="px-3 py-3 text-center font-medium text-gray-900 min-w-[7rem]">
                  <%= column.name %><% if column.key == ComplianceCheckStats::ASAP_V8_COLUMN_KEY %><span class="text-gray-500" title="See footnote">*</span><% end %>
                </th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% current_group = nil %>
            <% @checks.each do |check| %>
              <% if check.group_id != current_group %>
                <% current_group = check.group_id %>
                <tr class="bg-gray-100 border-t border-gray-200">
                  <td colspan="<%= @columns.size + 1 %>" class="px-4 py-2 text-xs font-semibold text-gray-800 sticky left-0 bg-gray-100">
                    <%= check.group_label.presence || check.group_id %>
                  </td>
                </tr>
              <% end %>
              <tr class="border-b border-gray-100 hover:bg-gray-50">
                <td class="px-4 py-2 sticky left-0 bg-white hover:bg-gray-50">
                  <div class="font-medium text-gray-900"><%= check.title %></div>
                  <div class="text-xs text-gray-500 font-mono"><%= check.field %></div>
                </td>
                <% @columns.each do |column| %>
                  <% counts = check.by_column[column.key] %>
                  <td class="px-3 py-2 text-center">
                    <% if counts.nil? || counts.total.zero? || (counts.pass_rate.nil? && !counts.warnings_only?) %>
                      <%
                        not_applicable_title =
                          if counts.nil? || counts.total.zero?
                            "Not applicable for this check and resource"
                          elsif counts.evaluated.zero?
                            "All are not applicable (#{counts.total} #{'dataset'.pluralize(counts.total)})"
                          else
                            "Not applicable for this check and resource"
                          end
                      %>
                      <span class="text-gray-400" title="<%= not_applicable_title %>">-</span>
                    <% elsif counts.warnings_only? %>
                      <%= link_to failing_check_datasets_stats_path(
                            column_key: column.key,
                            group_id: check.group_id,
                            field: check.canonical_field,
                            title: check.title,
                            column_name: column.name
                          ),
                          class: "inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-yellow-100 text-yellow-800 hover:ring-2 hover:ring-offset-1 hover:ring-gray-300",
                          title: "#{counts.warning} #{'warning'.pluralize(counts.warning)} only; excluded from pass rate — click to list projects",
                          data: { turbo: false, action: "click->stats-check-modal#open" } do %>
                        -
                      <% end %>
                    <% else %>
                      <%
                        rate = counts.pass_rate
                        status_class =
                          if rate == 100.0
                            "bg-green-100 text-green-800"
                          elsif rate >= 80.0
                            "bg-yellow-100 text-yellow-800"
                          else
                            "bg-red-100 text-red-800"
                          end
                        title = "passed #{counts.passed}, failed #{counts.failed}, warning #{counts.warning} (excluded from rate), skipped #{counts.skipped}"
                        not_passing = counts.failed + counts.warning
                        rate_label = "#{rate}%#{'*' if counts.warning.positive?}"
                        warning_note = counts.warning.positive? ? " — #{counts.warning} #{'warning'.pluralize(counts.warning)} excluded from rate" : ""
                      %>
                      <% if not_passing.positive? %>
                        <%= link_to failing_check_datasets_stats_path(
                              column_key: column.key,
                              group_id: check.group_id,
                              field: check.canonical_field,
                              title: check.title,
                              column_name: column.name
                            ),
                            class: "inline-flex items-center px-2 py-1 rounded text-xs font-semibold #{status_class} hover:ring-2 hover:ring-offset-1 hover:ring-gray-300",
                            title: "#{title}#{warning_note} — click to list projects not passing",
                            data: { turbo: false, action: "click->stats-check-modal#open" } do %>
                          <%= rate_label %>
                        <% end %>
                      <% else %>
                        <span class="inline-flex items-center px-2 py-1 rounded text-xs font-semibold <%= status_class %>"
                              title="<%= title %><%= warning_note %>">
                          <%= rate_label %>
                        </span>
                      <% end %>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
            <% if @checks.empty? %>
              <tr>
                <td colspan="<%= @columns.size + 1 %>" class="px-4 py-6 text-center text-gray-500">
                  No compliance check results imported yet.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <div class="mt-4 pt-3 pb-4 border-t border-gray-200">
          <p class="px-4 pb-3 text-xs text-gray-500">
            * At the moment, all currently scFAIR-valid projects are imported from CELLxGENE and automatically updated to comply with the scFAIR schema.
          </p>
          <h4 class="text-sm text-gray-800 text-center mb-3">Legend</h4>
          <div class="flex flex-wrap justify-center gap-3">
            <div class="flex items-center gap-2 bg-gray-50 rounded-lg px-3 py-2">
              <span class="px-2 py-1 rounded text-xs font-semibold bg-green-100 text-green-800">100%</span>
              <span class="text-xs text-gray-700">All pass/fail outcomes passed</span>
            </div>
            <div class="flex items-center gap-2 bg-gray-50 rounded-lg px-3 py-2">
              <span class="px-2 py-1 rounded text-xs font-semibold bg-yellow-100 text-yellow-800">80%+</span>
              <span class="text-xs text-gray-700">Mostly passed</span>
            </div>
            <div class="flex items-center gap-2 bg-gray-50 rounded-lg px-3 py-2">
              <span class="px-2 py-1 rounded text-xs font-semibold bg-red-100 text-red-800">&lt;80%</span>
              <span class="text-xs text-gray-700">Many failures</span>
            </div>
            <div class="flex items-center gap-2 bg-gray-50 rounded-lg px-3 py-2">
              <span class="px-2 py-1 rounded text-xs font-semibold bg-green-100 text-green-800">100%*</span>
              <span class="text-xs text-gray-700">All pass/fail outcomes passed; warnings present but excluded from rate</span>
            </div>
            <div class="flex items-center gap-2 bg-gray-50 rounded-lg px-3 py-2">
              <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-yellow-100 text-yellow-800">-</span>
              <span class="text-xs text-gray-700">Warnings only; click to list projects (excluded from pass rate)</span>
            </div>
            <div class="flex items-center gap-2 bg-gray-50 rounded-lg px-3 py-2">
              <span class="text-gray-400 text-xs font-medium px-2">-</span>
              <span class="text-xs text-gray-700">Not applicable for this check and resource; excluded from the pass rate</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="stats-check-modal"
       class="fixed inset-0 bg-gray-500 bg-opacity-75 z-50 hidden"
       data-action="click->stats-check-modal#backdropClose">
    <div class="fixed inset-0 z-50 overflow-y-auto" data-action="click->stats-check-modal#backdropClose">
      <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
        <div class="relative transform overflow-hidden rounded-lg bg-white px-4 pb-4 pt-5 text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-2xl sm:p-6"
             data-action="click->stats-check-modal#stopPropagation">
          <div class="absolute right-0 top-0 pr-4 pt-4">
            <button type="button"
                    class="rounded-md bg-white text-sm font-medium text-gray-500 hover:text-gray-700 focus:outline-none"
                    data-action="click->stats-check-modal#close">
              Close
            </button>
          </div>
          <div id="stats-check-modal-content"></div>
        </div>
      </div>
    </div>
  </div>
</div>
